# Names only. Copy to .env.local and fill in local values. Never commit real values.
DATABASE_URL=            # Neon pooled connection string (sslmode=require); local: postgres://<user>:<password>@localhost:5432/<db>
APP_ORIGIN=              # e.g. http://localhost:3000 locally; https://<prod-domain> in production
SESSION_COOKIE_SECURE=   # "true" in staging/production (defaults to true when NODE_ENV=production)
LOG_LEVEL=               # info | debug
